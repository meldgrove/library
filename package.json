{
  "name": "library",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-scripts.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "LIBRARY_PROCESS=migrate tsx --env-file-if-exists=.env.local src/scripts/migrate.ts",
    "worker": "LIBRARY_PROCESS=worker tsx --env-file-if-exists=.env.local src/workers/main.ts",
    "directory:sync": "LIBRARY_PROCESS=directory-sync tsx --env-file-if-exists=.env.local src/scripts/directory-sync.ts",
    "taxonomy:import": "LIBRARY_PROCESS=taxonomy-import tsx --env-file-if-exists=.env.local src/scripts/taxonomy-import.ts",
    "replay": "LIBRARY_PROCESS=replay tsx --env-file-if-exists=.env.local src/scripts/replay.ts",
    "dev:seed": "tsx --env-file-if-exists=.env.local dev/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@mozilla/readability": "^0.6.0",
    "@sentry/nextjs": "^11.11.0",
    "@sentry/node": "^11.11.0",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.9.1",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.68.0",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "description": "Meldgrove Library: a shared reading library with AI-drafted, human-checked source notes"
}
