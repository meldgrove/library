      "email": "erika@example.test",
      "emailVerified": true,
      "firstName": "Erika",
      "lastName": "Employee",
      "enabled": true,
      "groups": [
        "/library",
        "/teams/Engineering"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "library-dev",
          "temporary": false
        }
      ]
    },
    {
