# Local development. Copy to .env.local; `docker compose -f compose.dev.yaml
# up -d` starts PostgreSQL 18, Mailpit, and a Keycloak with a development
# realm and test users (password: library-dev): erika (has access), adam
# (admin), olga (no access).
# Every variable is described in docs/configuration.md.

LIBRARY_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://library:library@localhost:55444/library
# Any 32+ character string in development; production: openssl rand -base64 32
BETTER_AUTH_SECRET=development-secret-development-secret

# Login with any OpenID Connect provider; here the development Keycloak.
OIDC_ISSUER=http://localhost:8094/realms/library
OIDC_CLIENT_ID=library
OIDC_CLIENT_SECRET=library-dev-client-secret
# Optional: the sign-in button then reads "Sign in with Keycloak".
# OIDC_PROVIDER_NAME=Keycloak

# Where people, teams, and access come from: "manual" (invite people in
# the library) or "keycloak" (members of Keycloak groups). For the manual
# directory, set DIRECTORY=manual and INITIAL_ADMIN_EMAILS=adam@example.test.
DIRECTORY=keycloak
KEYCLOAK_ACCESS_GROUP=/library
KEYCLOAK_ADMIN_GROUP=/library-admins
KEYCLOAK_TEAMS_GROUP=/teams

# Development and tests only log Slack messages and emails. Production sends
# for real (the default when NODE_ENV=production) once Slack or email is set up.
NOTIFICATION_TRANSPORT=console
# To send emails to the development Mailpit (http://localhost:8026) instead:
# NOTIFICATION_TRANSPORT=live
# SMTP_URL=smtp://localhost:1026
# MAIL_FROM=library@example.test

# Originals: a directory here; production uses an S3 bucket (STORAGE_DRIVER=s3).
STORAGE_DRIVER=filesystem
STORAGE_DIR=.storage

# The AI model that drafts notes. "fake" drafts from the text without a model
# (development and tests only). Production: AI_PROVIDER=openai-compatible with
# AI_BASE_URL, AI_API_KEY, and AI_MODEL (docs/configuration.md).
AI_PROVIDER=fake
