# Fake but valid settings for the job "Compose files of the newest release"
# (.github/workflows/ci.yml): what a server of the newest release has in its
# .env. Public file: no real values. The job sets LIBRARY_VERSION and
# COMPOSE_FILE itself.
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://library:compat-only-password@postgres:5432/library
LIBRARY_BASE_URL=https://library.example.invalid
BETTER_AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
OIDC_ISSUER=https://sso.example.invalid/realms/library
OIDC_CLIENT_ID=library
OIDC_CLIENT_SECRET=compat-only
# The manual directory (the default) needs its first admins.
INITIAL_ADMIN_EMAILS=admin@example.invalid
# The worker needs a model (AI_PROVIDER defaults to openai-compatible); it is
# asked only when an upload is drafted.
AI_BASE_URL=https://ai.example.invalid/v1
AI_API_KEY=compat-only
AI_MODEL=compat-model
